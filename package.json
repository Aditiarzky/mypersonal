{
  "name": "personal-portfolio",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "bun run --filter web dev",
    "dev:api": "bun run --filter api dev",
    "build:web": "bun run --filter web build",
    "check:web": "bun run --filter web check",
    "check:api": "bun run --filter api typecheck",
    "db:migrate:local": "bun run --filter api db:migrate:local",
    "seed:admin:local": "bun run --filter api seed:admin:local",
    "seed:admin:remote": "bun run --filter api seed:admin:remote"
  },
  "devDependencies": {
    "@iconify/svelte": "^5.2.4",
    "add": "^2.0.9",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.67.0"
  }
}
